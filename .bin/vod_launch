#!/usr/bin/env bash
set -eo pipefail

if [[ "$3" = "c0" ]]; then
  streamlink_args="-p mpv --ringbuffer-size=16M"
  cache_args="--cache=no"
elif [[ "$3" = "c1" ]]; then
  streamlink_args="-p mpv --ringbuffer-size=200M"
  cache_args="--cache=yes --cache-secs=600 --demuxer-max-bytes=400MiB --demuxer-max-back-bytes=100MiB"
elif [[ "$3" = "c2" ]]; then
  streamlink_args="-p mpv --ringbuffer-size=500M"
  cache_args="--cache=yes --cache-secs=1800 --demuxer-max-bytes=750MiB --demuxer-max-back-bytes=150MiB"
else
  streamlink_args="-p mpv --ringbuffer-size=1000M"
  cache_args="--cache=yes --cache-secs=3600 --demuxer-max-bytes=1250MiB --demuxer-max-back-bytes=250MiB"
fi

yt_profile="$4"

socket_args=""
if [[ ! -z "$5" && "$5" != "await" && "$5" != "record" ]]; then
  mpv_socket="/tmp/mpv_${5}_stream"
  socket_args=" --input-ipc-server=$mpv_socket"
  tmux split-window -v -t background vod_ts "$1" "$mpv_socket"
  tmux last-pane -t background
fi

playNewestRecording() {
  sleep 5
  vod_file_name="$(ls -1 -t "$HOME/tor/streams" | head -n 1)"
  mpv --save-position-on-quit "$HOME/tor/streams/$vod_file_name"
}

if [[ $1 = *youtu* ]]; then
  mpv --profile=$yt_profile $cache_args $socket_args "$1" &
  mpv_id=$!
  while pgrep mpv | grep -q "$mpv_id"; do
    sleep 15
  done
elif [[ -f "$1" ]]; then
  mpv --save-position-on-quit "$1"
else
  if [[ "$5" = "await" ]]; then
    vod_online "$1" "await"
  elif [[ "$5" = "record" ]]; then
    mkdir -p "$HOME/tor/streams"
    streamlink_args="$streamlink_args --output $HOME/tor/streams/{author}_{time:%Y%m%D_%H%M}.ts"
    playNewestRecording &
  fi

  streamlink $streamlink_args -a "$cache_args $socket_args" "$1" "$2"
fi
